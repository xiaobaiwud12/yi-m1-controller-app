# Git ignore rules for the release repository.
#
# This repository is the application only. The development repository it is
# exported from also carries firmware images, a decompiled vendor application,
# reverse-engineering notes and captured camera credentials; none of that exists
# here, and that is the point of keeping the two separate rather than rewriting
# one repository's history.
#
# `app/.gitignore` already covers the Flutter and Android build outputs. The
# entries below are the ones that live above `app/`, plus the two generated files
# under `app/lib/l10n/` that the app's own ignore file does not name.

# Flutter and Dart build output.
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
**/generated_plugin_registrant.dart
**/generated_plugins.cmake
**/generated_plugin_registrant.h
**/generated_plugin_registrant.cc
*.g.dart
*.freezed.dart

# Android build output and machine-specific SDK paths. `local.properties` names
# this machine's SDK and Flutter directories; it is regenerated by `flutter pub
# get`.
app/android/.gradle/
app/android/local.properties
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/android/captures/
app/android/build/
*.jks
*.keystore

# Localisation. `app/l10n.yaml` writes `app/l10n_untranslated.json` on every run
# (`flutter: generate: true` in pubspec.yaml drives it), so it is a generated report
# and is not tracked. The *sources* — `app/lib/l10n/app_en.arb` and `app_zh.arb` —
# are tracked and must stay tracked.
#
# `app/lib/l10n/gen/` is **not** ignored, deliberately. It is generated too, but
# `lib/l10n/l10n.dart` imports it, so a fresh clone needs it to analyze or build at
# all: ignoring it would greet every contributor with a missing-import error and make
# `dart tool/verify.dart` fail for a reason that has nothing to do with their change.
# The file that would have ignored it said "generated output, not a source file",
# which was true and not the point.
app/l10n_untranslated.json

# Test and tool scratch.
app/coverage/
app/test/**/failures/

# OS and editor noise.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.iml
*.swp
*~
