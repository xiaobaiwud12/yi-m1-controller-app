<?xml version="1.0" encoding="utf-8"?>
<!--
     The adaptive icon, API 33+.

     `foreground` and `background` are separate layers because the launcher
     scales and masks them independently: the background is drawn full bleed and
     the foreground is deliberately inset so that no mask (circle, squircle or
     rounded square) can crop the mark.

     Generated by tools/icon/make_launcher_icon.py. Do not hand-edit as a
     source of truth; edit the script and re-run it. The geometry id is
     yi-m1-controller/launcher-icon/1; app/tool/verify_icon.dart re-derives the safe-zone
     claim from these files, so a hand edit that breaks it fails `verify`.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
